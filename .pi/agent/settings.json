{
  "packages": [
    "git:github.com/dmmulroy/pi-mcp",
    "npm:@cortexkit/pi-anthropic-auth",
    "npm:pi-autoresearch"
  ],
  "startup": {
    "model": "gpt-6-astra",
    "provider": "openai-codex-lb",
    "thinkingLevel": "high"
  },
  "enabledModels": [
    "openai-codex-lb/gpt-6-astra",
    "openai-codex-lb/gpt-reserve",
    "openai-codex-lb/gpt-5.3-codex-spark",
    "google/gemini-3.8-flash",
    "anthropic/claude-fable-5-1",
    "deepseek/deepseek-v4-pro",
    "openrouter/deepseek/deepseek-v4-pro",
    "nvidia/deepseek-ai/deepseek-v4-pro-0813",
    "deepseek/deepseek-v4-flash",
    "openrouter/deepseek/deepseek-v4-flash",
    "nvidia/deepseek-ai/deepseek-v4-flash-0731",
    "openrouter/moonshotai/kimi-k3",
    "nvidia/moonshotai/kimi-k3",
    "openrouter/z-ai/glm-5.3",
    "opencode/muse-spark-1.3-contributor-free"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "999.999.999",
  "quietStartup": true,
  "transport": "websocket-cached",
  "terminal": {
    "showTerminalProgress": true
  },
  "npmCommand": ["sfw", "npm"],
  "showCacheMissNotices": true,
  "theme": "light",
  "tuiMode": "fullscreen"
}
