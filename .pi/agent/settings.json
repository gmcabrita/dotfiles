{
  "packages": ["git:github.com/dmmulroy/pi-mcp", "npm:@cortexkit/pi-anthropic-auth"],
  "startup": {
    "model": "claude-fable-5-1",
    "provider": "anthropic",
    "thinkingLevel": "high"
  },
  "sessionPurpose": {
    "implement": {
      "provider": "anthropic",
      "model": "claude-fable-5-1",
      "thinkingLevel": "high"
    },
    "reverse": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "thinkingLevel": "high"
    },
    "debug": {
      "provider": "openai-codex-lb",
      "model": "gpt-6-astra",
      "thinkingLevel": "high"
    },
    "review": {
      "provider": "openai-codex-lb",
      "model": "gpt-6-astra",
      "thinkingLevel": "high"
    },
    "investigate": {
      "provider": "openai-codex-lb",
      "model": "gpt-6-astra",
      "thinkingLevel": "high"
    }
  },
  "enabledModels": [
    "openai-codex-lb/gpt-6-astra",
    "openai-codex-lb/gpt-reserve",
    "openai-codex-lb/gpt-5.3-codex-spark",
    "anthropic/claude-fable-5-1",
    "deepseek/deepseek-flash",
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openrouter/moonshotai/kimi-k3",
    "openrouter/z-ai/glm-5.3",
    "opencode/muse-spark-1.3-contributor-free"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "999.999.999",
  "quietStartup": true,
  "transport": "websocket-cached",
  "terminal": {
    "showTerminalProgress": true
  },
  "npmCommand": ["sfw", "npm"],
  "showCacheMissNotices": true,
  "theme": "light",
  "tuiMode": "fullscreen",
  "warnings": {
    "anthropicExtraUsage": false
  }
}
