{
  "packages": [
    "git:github.com/dmmulroy/pi-mcp",
    "npm:pi-anthropic-oauth",
    "npm:@narumitw/pi-firecrawl"
  ],
  "startup": {
    "model": "gpt-5.6-sol",
    "provider": "openai-codex-lb",
    "thinkingLevel": "high"
  },
  "enabledModels": [
    "openai-codex-lb/gpt-5.6-sol",
    "openai-codex-lb/gpt-5.6-terra",
    "openai-codex-lb/gpt-5.6-luna",
    "anthropic/claude-fable-5",
    "anthropic/claude-opus-5",
    "deepseek/deepseek-v4-pro",
    "deepseek/deepseek-v4-flash",
    "openrouter/deepseek/deepseek-v4-pro",
    "openrouter/deepseek/deepseek-v4-flash",
    "openrouter/moonshotai/kimi-k3",
    "openrouter/z-ai/glm-5.3"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "999.999.999",
  "quietStartup": true,
  "transport": "websocket-cached",
  "terminal": {
    "showTerminalProgress": true
  },
  "npmCommand": ["sfw", "npm"],
  "showCacheMissNotices": true,
  "theme": "light",
  "tuiMode": "fullscreen"
}
