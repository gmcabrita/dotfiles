{
  "$schema": "https://ccusage.com/config-schema.json",
  "defaults": {
    "timezone": "UTC",
    "breakdown": true,
    "noCost": true
  },
  "pi": {
    "stores": [
      {
        "name": "pi-tmux-subagents",
        "path": "~/.pi/agent/tmux-subagents"
      },
      {
        "name": "pi-subagents",
        "path": "~/.pi/agent/subagents"
      }
    ]
  }
}
