#!/usr/bin/env python3
"""Regenerate copies of .psql/queries: derived query files and pgcli named queries."""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
QUERIES = ROOT / ".psql/queries"
PGCLI_CONFIG = ROOT / ".config/pgcli/config"

# btree_bloat_estimation reports every btree index. bloat_size is never
# negative, so a min_bloat_size of -1 makes the final filter keep every row.
BTREE_BLOAT_ESTIMATION_THRESHOLDS = {"min_index_size": "0", "min_bloat_size": "-1"}


def derive_btree_bloat_estimation(candidates: str) -> str:
    query = candidates
    for name, value in BTREE_BLOAT_ESTIMATION_THRESHOLDS.items():
        query, count = re.subn(
            rf"^(\s*)\S+( as {name},)$", rf"\g<1>{value}::numeric\2", query, flags=re.MULTILINE
        )
        if count != 1:
            sys.exit(f"btree_reindex_candidates.sql: expected one `as {name},` constant")
    noqa, rest = query.split("\n", 1)
    header = (
        "-- Generated by bin/sync-queries from btree_reindex_candidates.sql with"
        " its thresholds disabled. Edit that file instead."
    )
    return f"{noqa}\n{header}\n{rest}"


def sync_pgcli_named_queries(config: str, queries: dict[str, str]) -> str:
    def replace(match: re.Match[str]) -> str:
        name = match["name"]
        if name not in queries:
            return match[0]
        body = queries[name].rstrip("\n")
        if '"""' in body:
            sys.exit(f'{name}.sql: contains """, which pgcli named queries cannot hold')
        return f'{name} = """{body}"""'

    head, named_queries = config.split("[named queries]\n", 1)
    named_queries = re.sub(
        r'^(?P<name>[a-z0-9_]+) = """.*?"""', replace, named_queries, flags=re.MULTILINE | re.DOTALL
    )
    return f"{head}[named queries]\n{named_queries}"


def write_if_changed(path: Path, content: str) -> None:
    if path.read_text() != content:
        path.write_text(content)
        print(f"updated {path.relative_to(ROOT)}")


def main() -> None:
    candidates = (QUERIES / "btree_reindex_candidates.sql").read_text()
    write_if_changed(
        QUERIES / "btree_bloat_estimation.sql", derive_btree_bloat_estimation(candidates)
    )
    queries = {path.stem: path.read_text() for path in QUERIES.glob("*.sql")}
    write_if_changed(PGCLI_CONFIG, sync_pgcli_named_queries(PGCLI_CONFIG.read_text(), queries))


if __name__ == "__main__":
    main()
