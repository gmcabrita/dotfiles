#!/usr/bin/env bash
set -euo pipefail

SQL_FILE="${HOME}/.psql/queries/btree_reindex_candidates.sql"
INPUT_TARGETS=()
TARGETS=()

log() {
  printf '%s\n' "$*" >&2
}

help() {
  echo "Run btree_reindex_candidates.sql against production databases."
  echo ""
  echo "Usage: btree_reindex_candidates_ampledash [<instance>|<database> ...]"
  echo "       btree_reindex_candidates_ampledash < targets.txt"
  echo ""
  echo "Targets: one per argument or stdin line, as <instance>|<database>."
  echo "Stdin lines may also use whitespace: <instance> <database>."
  echo "Blank stdin lines and lines starting with # are ignored."
  echo ""
  echo "Example:"
  echo "  btree_reindex_candidates_ampledash 'ampledash-prod-3|ampledash_prod'"
  echo ""
  echo "Options:"
  echo "  -h, --help  Show this help"
  echo ""
  echo "Output: CSV: database,tbl,idx,bloat_size_pretty,bloat_pct,real_size"
  exit "${1:-1}"
}

add_target() {
  local target="$1"
  local instance=""
  local db_name=""
  local extra=""

  if [[ "${target}" =~ ^[[:space:]]*$ ]] || [[ "${target}" =~ ^[[:space:]]*# ]]; then
    return
  fi

  if [[ "${target}" = *"|"* ]]; then
    IFS='|' read -r instance db_name extra <<< "${target}"
  else
    read -r instance db_name extra <<< "${target}"
  fi

  if [ -z "${instance}" ] || [ -z "${db_name}" ] || [ -n "${extra}" ]; then
    echo "Error: invalid target '${target}'" >&2
    echo "Expected: <instance>|<database> or <instance> <database>" >&2
    exit 1
  fi

  TARGETS+=("${instance}|${db_name}")
}

read_stdin_targets() {
  local target

  while IFS= read -r target; do
    add_target "${target}"
  done
}

run_query() {
  local instance="$1"
  local db_name="$2"

  log "Running query on ${instance}/${db_name} (can take several minutes on large databases)..."

  # amplmkt overrides application_name from PGOPTIONS, so set it in the session.
  # AMPLMKT_CLI_PSQL_BIN selects the client that amplmkt starts. Force psql for the flags below.
  AMPLMKT_CLI_PSQL_BIN=psql amplmkt db connect --instance "${instance}" --database "${db_name}" --role readonly -- \
      --no-psqlrc \
      --pset=pager=off \
      --csv \
      -q \
      -t \
      -v ON_ERROR_STOP=1 \
      -c "set application_name = 'btree_reindex_candidates'" \
      -f "${SQL_FILE}" \
    | awk -v db="${db_name}" '
        BEGIN { FS = "," }
        function unquote(value) {
          if (substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"")
            return substr(value, 2, length(value) - 2)
          return value
        }
        NF >= 8 {
          printf "%s,%s,%s,%s,%s,%s\n", db, unquote($1), unquote($2), unquote($7), unquote($8), unquote($3)
        }'
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      help 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      help
      ;;
    *)
      INPUT_TARGETS+=("$1")
      ;;
  esac
  shift
done

if [ ! -f "${SQL_FILE}" ]; then
  echo "Error: SQL file '${SQL_FILE}' not found" >&2
  exit 1
fi

if [ "${#INPUT_TARGETS[@]}" -gt 0 ]; then
  for target in "${INPUT_TARGETS[@]}"; do
    add_target "${target}"
  done
elif [ -t 0 ]; then
  echo "Error: no targets provided" >&2
  help
else
  read_stdin_targets
fi

if [ "${#TARGETS[@]}" -eq 0 ]; then
  echo "Error: no targets provided" >&2
  exit 1
fi

echo "database,tbl,idx,bloat_size_pretty,bloat_pct,real_size"

for target in "${TARGETS[@]}"; do
  IFS='|' read -r instance db_name <<< "${target}"
  run_query "${instance}" "${db_name}"
done

log "Done."
