#!/usr/bin/env bun
// Finds bloated btree indexes on every production PostgreSQL primary and reindexes them with amplmkt.
// Shows progress in a TUI and lets failed or queued reindexes be started from it.
import { BunRuntime, BunServices } from "@effect/platform-bun@4.1.5";
import {
  BoxRenderable,
  RGBA,
  SelectRenderable,
  TextAttributes,
  TextRenderable,
  createCliRenderer,
} from "@opentui/core@0.9.7";
import type { KeyEvent } from "@opentui/core@0.9.7";
import {
  Clock,
  Config,
  Console,
  Context,
  Deferred,
  Duration,
  Effect,
  FiberSet,
  FileSystem,
  Layer,
  Predicate,
  Queue,
  Ref,
  Schedule,
  Schema,
  Stream,
} from "effect@4.1.5";
import { Command, Flag } from "effect@4.1.5/cli";
import { ChildProcess, ChildProcessSpawner } from "effect@4.1.5/process";
import { homedir } from "node:os";
import { join } from "node:path";

const CANDIDATES_SQL = join(homedir(), ".psql/queries/btree_reindex_candidates.sql");
const MAX_REINDEXES_PER_INSTANCE = 3;
const SKIPPED_INSTANCE_PREFIX = "amplmkt-gcp-prod-usce1-cluster";
const LIST_DATABASES_SQL =
  "select datname from pg_database where datallowconn and not datistemplate and datname not in ('cloudsqladmin', 'rdsadmin') order by datname";

// ---------------------------------------------------------------------------
// Functional core
// ---------------------------------------------------------------------------

type ReindexState =
  // `manualOrder` is set when started from the TUI; those entries go first, in the order they were picked.
  | { readonly kind: "queued"; readonly manualOrder?: number }
  | { readonly kind: "starting" }
  | {
      readonly id: string;
      readonly kind: "running";
      readonly pollError?: string;
      readonly serverStatus: string;
      readonly startedAt: number;
    }
  | {
      readonly finishedAt: number;
      readonly id: string;
      readonly kind: "succeeded";
      readonly startedAt: number;
    }
  | {
      readonly finishedAt: number;
      readonly id: string;
      readonly kind: "failed";
      readonly startedAt: number;
    }
  | { readonly error: string; readonly kind: "start_failed" };

interface Candidate {
  readonly bloatPct: string;
  readonly bloatSize: string;
  readonly index: string;
  readonly realSize: string;
  readonly table: string;
}

interface Entry extends Candidate {
  readonly database: string;
  readonly instance: string;
  readonly key: string;
  readonly schema: string;
  readonly state: ReindexState;
}

interface Problem {
  readonly message: string;
  readonly where: string;
}

interface Phase {
  readonly label: string;
  readonly mark: "active" | "done" | "skipped" | "error";
  readonly since: number;
}

interface AppState {
  readonly authFailing: boolean;
  readonly databaseScans: { readonly done: number; readonly total: number };
  readonly dryRun: boolean;
  readonly entries: ReadonlyArray<Entry>;
  readonly instances: ReadonlyArray<string>;
  readonly nextManualOrder: number;
  readonly notice: string;
  readonly phases: Readonly<Record<string, Phase>>;
  readonly problems: ReadonlyArray<Problem>;
  readonly quitRequested: boolean;
  readonly startupStep: string | undefined;
}

const initialState = (dryRun: boolean): AppState => ({
  authFailing: false,
  databaseScans: { done: 0, total: 0 },
  dryRun,
  entries: [],
  instances: [],
  nextManualOrder: 0,
  notice: "",
  phases: {},
  problems: [],
  quitRequested: false,
  startupStep: "Checking amplmkt session…",
});

function selectPrimaryInstances(
  instances: ReadonlyArray<{ readonly kind: string; readonly name: string }>,
): Array<string> {
  return instances.flatMap((i) =>
    i.kind === "cloudsql" &&
    !i.name.startsWith(SKIPPED_INSTANCE_PREFIX) &&
    !i.name.includes("replica")
      ? [i.name]
      : [],
  );
}

function nonEmptyLines(text: string): Array<string> {
  return text
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l !== "");
}

type InstanceCheck =
  | { readonly kind: "replica" }
  | { readonly databases: ReadonlyArray<string>; readonly kind: "primary" };

// Output of `select pg_is_in_recovery()` followed by the database list.
function parseInstanceCheck(stdout: string): InstanceCheck {
  const [inRecovery, ...databases] = nonEmptyLines(stdout);
  return inRecovery === "t" ? { kind: "replica" } : { databases, kind: "primary" };
}

// Column order of btree_reindex_candidates.sql:
// tbl, idx, real_size, extra_size, extra_pct, fillfactor, bloat_size_pretty, bloat_pct
function parseCandidates(stdout: string): Array<Candidate> {
  return nonEmptyLines(stdout).flatMap((line) => {
    const [table, index, realSize, , , , bloatSize, bloatPct] = line.split("\t");
    return table && index && realSize && bloatSize && bloatPct
      ? [{ bloatPct, bloatSize, index, realSize, table }]
      : [];
  });
}

function sqlLiteral(value: string): string {
  return `'${value.replaceAll("'", "''")}'`;
}

function schemaLookupSql(candidates: ReadonlyArray<Candidate>): string {
  const pairs = candidates
    .map((c) => `(${sqlLiteral(c.table)}, ${sqlLiteral(c.index)})`)
    .join(", ");
  return `select tablename, indexname, schemaname from pg_indexes where (tablename::text, indexname::text) in (values ${pairs})`;
}

function parseSchemaLookup(stdout: string): Map<string, Array<string>> {
  const schemas = new Map<string, Array<string>>();
  for (const line of nonEmptyLines(stdout)) {
    const [table, index, schema] = line.split("\t");
    if (table && index && schema) {
      const key = `${table}\t${index}`;
      schemas.set(key, [...(schemas.get(key) ?? []), schema]);
    }
  }
  return schemas;
}

const isInFlight = (e: Entry) => e.state.kind === "starting" || e.state.kind === "running";
const tableKey = (e: Entry) => `${e.database}\t${e.schema}\t${e.table}`;
const queueOrder = (e: Entry) =>
  e.state.kind === "queued" ? (e.state.manualOrder ?? Infinity) : Infinity;

// Per instance: at most `maxPerInstance` reindexes in flight, never two on the same table.
function pickReindexesToStart(entries: ReadonlyArray<Entry>, maxPerInstance: number): Array<Entry> {
  const picked: Array<Entry> = [];
  const byInstance = Map.groupBy(entries, (e) => e.instance);
  for (const instanceEntries of byInstance.values()) {
    const inFlight = instanceEntries.filter(isInFlight);
    const busyTables = new Set(inFlight.map(tableKey));
    let slots = maxPerInstance - inFlight.length;
    for (const entry of instanceEntries.toSorted((a, b) => queueOrder(a) - queueOrder(b))) {
      if (slots <= 0) {
        break;
      }
      if (entry.state.kind !== "queued" || busyTables.has(tableKey(entry))) {
        continue;
      }
      picked.push(entry);
      busyTables.add(tableKey(entry));
      slots--;
    }
  }
  return picked;
}

const isAuthError = (message: string) => message.includes("amplmkt auth login");

function updateEntry(state: AppState, key: string, f: (entry: Entry) => Entry): AppState {
  return { ...state, entries: state.entries.map((e) => (e.key === key ? f(e) : e)) };
}

function noteAmplmktResult(state: AppState, error?: string): AppState {
  return { ...state, authFailing: error !== undefined && isAuthError(error) };
}

function addProblem(state: AppState, where: string, message: string): AppState {
  return noteAmplmktResult(
    { ...state, problems: [...state.problems, { message, where }] },
    message,
  );
}

function setPhase(
  state: AppState,
  instance: string,
  label: string,
  mark: Phase["mark"],
  now: number,
): AppState {
  return { ...state, phases: { ...state.phases, [instance]: { label, mark, since: now } } };
}

function startScanning(state: AppState, instances: ReadonlyArray<string>, now: number): AppState {
  return instances.reduce<AppState>(
    (s, instance) => setPhase(s, instance, "waiting", "active", now),
    {
      ...state,
      instances,
      startupStep: undefined,
    },
  );
}

function countDatabaseScans(state: AppState, change: { done?: number; total?: number }): AppState {
  const { done, total } = state.databaseScans;
  return {
    ...state,
    databaseScans: { done: done + (change.done ?? 0), total: total + (change.total ?? 0) },
  };
}

function addCandidates(
  state: AppState,
  instance: string,
  database: string,
  candidates: ReadonlyArray<Candidate>,
  schemas: Map<string, Array<string>>,
): AppState {
  let next = state;
  const entries: Array<Entry> = [];
  for (const c of candidates) {
    const matches = schemas.get(`${c.table}\t${c.index}`) ?? [];
    const [schema] = matches;
    if (schema === undefined || matches.length > 1) {
      const reason =
        matches.length === 0 ? "schema not found" : `ambiguous schema (${matches.join(", ")})`;
      next = addProblem(
        next,
        `${instance}/${database}`,
        `skipped ${c.table}.${c.index}: ${reason}`,
      );
      continue;
    }
    entries.push({
      database,
      instance,
      key: `${instance}\t${database}\t${schema}\t${c.index}`,
      schema,
      ...c,
      state: { kind: "queued" },
    });
  }
  return { ...next, entries: [...next.entries, ...entries] };
}

// Marks the reindexes allowed to start as `starting` in the same update, so concurrent callers never claim one twice.
function claimReindexes(state: AppState, maxPerInstance: number): [ReadonlyArray<Entry>, AppState] {
  if (state.dryRun || state.quitRequested) {
    return [[], state];
  }
  const picked = pickReindexesToStart(state.entries, maxPerInstance);
  const keys = new Set(picked.map((e) => e.key));
  const entries = state.entries.map((e): Entry =>
    keys.has(e.key) ? { ...e, state: { kind: "starting" } } : e,
  );
  return [picked, { ...state, entries }];
}

function applyServerStatus(
  entry: Entry,
  id: string,
  status: string,
  startedAt: number,
  now: number,
): Entry {
  if (status === "succeeded" || status === "failed") {
    return { ...entry, state: { finishedAt: now, id, kind: status, startedAt } };
  }
  return { ...entry, state: { id, kind: "running", serverStatus: status, startedAt } };
}

function retryFailedStarts(state: AppState, keys: ReadonlySet<string>): AppState {
  return {
    ...state,
    entries: state.entries.map((e): Entry =>
      keys.has(e.key) && e.state.kind === "start_failed" ? { ...e, state: { kind: "queued" } } : e,
    ),
  };
}

// Moves the entry to the front of its instance's queue; claimReindexes still enforces the limits.
function startNext(state: AppState, key: string): AppState {
  const entry = state.entries.find((e) => e.key === key);
  if (
    state.dryRun ||
    !entry ||
    (entry.state.kind !== "queued" && entry.state.kind !== "start_failed")
  ) {
    return state;
  }
  const prioritized = updateEntry(state, key, (e) => ({
    ...e,
    state: { kind: "queued", manualOrder: state.nextManualOrder },
  }));
  return { ...prioritized, nextManualOrder: state.nextManualOrder + 1 };
}

// Quitting with reindexes in flight needs a second press. Reindexes keep running server-side either way.
function requestQuit(state: AppState): ["quit" | "confirm", AppState] {
  const inFlight = state.entries.filter(isInFlight).length;
  if (inFlight === 0 || state.quitRequested) {
    return ["quit", state];
  }
  const notice = `${inFlight} reindex${inFlight === 1 ? "" : "es"} still in progress server-side; press q again to quit`;
  return ["confirm", { ...state, notice, quitRequested: true }];
}

function cancelQuit(state: AppState): AppState {
  return state.quitRequested ? { ...state, notice: "", quitRequested: false } : state;
}

// --- Presentation -----------------------------------------------------------

const SPINNER = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
const PHASE_MARKS = { done: "✓", error: "✗", skipped: "–" } as const;
const spinnerFrame = (now: number) => SPINNER[Math.floor(now / 100) % SPINNER.length];

function formatDuration(ms: number): string {
  const s = Math.max(0, Math.floor(ms / 1000));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  if (h > 0) {
    return `${h}h${String(m).padStart(2, "0")}m`;
  }
  if (m > 0) {
    return `${m}m${String(s % 60).padStart(2, "0")}s`;
  }
  return `${s}s`;
}

function describeQueued(
  entry: Entry,
  entries: ReadonlyArray<Entry>,
  maxPerInstance: number,
): string {
  const inFlight = entries.filter((e) => e.instance === entry.instance && isInFlight(e));
  const label =
    entry.state.kind === "queued" && entry.state.manualOrder !== undefined
      ? "queued (next)"
      : "queued";
  if (inFlight.some((e) => tableKey(e) === tableKey(entry))) {
    return `${label}, table busy`;
  }
  if (inFlight.length >= maxPerInstance) {
    return `${label}, instance at ${inFlight.length}/${maxPerInstance}`;
  }
  return label;
}

function describeState(entry: Entry, entries: ReadonlyArray<Entry>, now: number): string {
  const state = entry.state;
  switch (state.kind) {
    case "queued":
      return describeQueued(entry, entries, MAX_REINDEXES_PER_INSTANCE);
    case "starting":
      return "starting…";
    case "running":
      return `${state.serverStatus} ${formatDuration(now - state.startedAt)}${state.pollError ? " (status check failing)" : ""}`;
    case "succeeded":
      return `succeeded in ${formatDuration(state.finishedAt - state.startedAt)}`;
    case "failed":
      return `failed after ${formatDuration(state.finishedAt - state.startedAt)}`;
    case "start_failed":
      return "start failed (r to retry)";
  }
}

function reportResult(state: ReindexState): string {
  switch (state.kind) {
    case "queued":
      return "not started";
    case "starting":
      return "start in flight";
    case "running":
      return `in progress (${state.serverStatus})`;
    case "succeeded":
      return "succeeded";
    case "failed":
      return "failed";
    case "start_failed":
      return `not started: ${state.error}`;
  }
}

function truncate(value: string, width: number): string {
  if (value.length <= width) {
    return value.padEnd(width);
  }
  return `${value.slice(0, Math.max(0, width - 1))}…`;
}

const MIN_COLUMN_WIDTH = 8;

interface FormattedTable {
  readonly header: string;
  readonly lines: ReadonlyArray<string>;
}

// Shrinks the widest `shrinkable` column until a row fits `maxLineWidth`. The last column is never truncated.
function formatTable(
  header: ReadonlyArray<string>,
  rows: ReadonlyArray<ReadonlyArray<string>>,
  {
    maxLineWidth = Infinity,
    shrinkable = [],
  }: { maxLineWidth?: number; shrinkable?: ReadonlyArray<number> } = {},
): FormattedTable {
  const widths = header.map((h, i) => Math.max(h.length, ...rows.map((r) => r[i]?.length ?? 0)));
  const width = (i: number) => widths[i] ?? 0;
  const lineWidth = () => widths.reduce((sum, w) => sum + w, 0) + 2 * (widths.length - 1);
  while (lineWidth() > maxLineWidth) {
    const [widest] = shrinkable
      .filter((i) => width(i) > MIN_COLUMN_WIDTH)
      .toSorted((a, b) => width(b) - width(a));
    if (widest === undefined) {
      break;
    }
    widths[widest] = width(widest) - 1;
  }
  const line = (cols: ReadonlyArray<string>) =>
    cols.map((c, i) => (i === cols.length - 1 ? c : truncate(c, width(i)))).join("  ");
  return { header: line(header), lines: rows.map(line) };
}

function formatTableText(
  header: ReadonlyArray<string>,
  rows: ReadonlyArray<ReadonlyArray<string>>,
): string {
  const table = formatTable(header, rows);
  return [table.header, ...table.lines].join("\n");
}

const sortedEntries = (state: AppState) =>
  state.entries.toSorted(
    (a, b) => a.instance.localeCompare(b.instance) || a.database.localeCompare(b.database),
  );

const isScanning = (state: AppState) =>
  Object.values(state.phases).some((p) => p.mark === "active");

function headerLine(state: AppState, now: number): string {
  const spinner = spinnerFrame(now);
  const count = (kind: ReindexState["kind"]) =>
    state.entries.filter((e) => e.state.kind === kind).length;
  const scanning = Object.values(state.phases).filter((p) => p.mark === "active").length;
  const { done, total } = state.databaseScans;
  const scanStatus = state.startupStep
    ? `${spinner} ${state.startupStep}`
    : scanning > 0
      ? `${spinner} scanning ${scanning}/${state.instances.length} instances, ${done}/${total} databases done`
      : "scan done";
  return [
    state.dryRun ? "btree-reindex-amplmkt (dry run)" : "btree-reindex-amplmkt",
    scanStatus,
    `${state.entries.length} candidates`,
    `queued ${count("queued")}`,
    `running ${count("starting") + count("running")}`,
    `succeeded ${count("succeeded")}`,
    `failed ${count("failed")}`,
    `start failed ${count("start_failed")}`,
  ].join(" · ");
}

const KEY_HELP =
  "↑/↓ move · s start selected next · r retry selected failed start · R retry all failed starts · q quit";

// Warnings replace the key help so they are never cut off at the end of the long header.
function footerLine(state: AppState): { text: string; warning: boolean } {
  const warnings = [
    state.authFailing ? "amplmkt session expired: run `amplmkt auth login`" : "",
    state.notice,
  ].filter(Boolean);
  return warnings.length > 0
    ? { text: `⚠ ${warnings.join(" · ")}`, warning: true }
    : { text: KEY_HELP, warning: false };
}

function emptyStateText(state: AppState, now: number): string {
  const spinner = spinnerFrame(now);
  if (state.startupStep) {
    return `\n  ${spinner} ${state.startupStep}`;
  }
  if (!isScanning(state)) {
    return "\n  No reindex candidates found.";
  }
  return (
    `\n  ${spinner} Looking for bloated btree indexes. No candidates yet.\n\n` +
    "  The candidate query can take several minutes on large databases.\n" +
    `  Candidates appear here as each database finishes${state.dryRun ? "" : ", and their reindexes start right away"}.\n` +
    "  Per-instance progress is shown below."
  );
}

function entryTable(state: AppState, now: number, maxLineWidth: number) {
  const view = sortedEntries(state);
  const { header, lines } = formatTable(
    ["INSTANCE", "DATABASE", "TABLE", "INDEX", "BLOAT", "STATUS"],
    view.map((e) => [
      e.instance,
      e.database,
      e.table,
      e.index,
      `${e.bloatSize} ${e.bloatPct}%`,
      describeState(e, state.entries, now),
    ]),
    { maxLineWidth, shrinkable: [0, 1, 2, 3] },
  );
  return { header, rows: view.map((e, i) => ({ key: e.key, line: lines[i] ?? "" })) };
}

function instanceLines(state: AppState, now: number): string {
  const nameWidth = Math.max(0, ...state.instances.map((i) => i.length));
  return state.instances
    .flatMap((instance) => {
      const phase = state.phases[instance];
      if (!phase) {
        return [];
      }
      const mark = phase.mark === "active" ? spinnerFrame(now) : PHASE_MARKS[phase.mark];
      const found = state.entries.filter((e) => e.instance === instance).length;
      const elapsed = phase.mark === "active" ? ` ${formatDuration(now - phase.since)}` : "";
      return `${mark} ${instance.padEnd(nameWidth)}  ${phase.label}${elapsed}${found > 0 ? ` · ${found} found` : ""}`;
    })
    .join("\n");
}

function describeEntry(e: Entry): string {
  const s = e.state;
  const id = "id" in s ? `reindex id ${s.id}` : "";
  const error =
    s.kind === "start_failed"
      ? s.error
      : s.kind === "running" && s.pollError
        ? `status check: ${s.pollError}`
        : "";
  return [
    `${e.instance}/${e.database}  ${e.schema}.${e.table}  ${e.index}`,
    [`size ${e.realSize}`, `bloat ${e.bloatSize} (${e.bloatPct}%)`, id].filter(Boolean).join(" · "),
    error,
  ].join("\n");
}

function formatReport(state: AppState): string {
  const rows = sortedEntries(state).map((e) => {
    const s = e.state;
    return [
      e.instance,
      e.database,
      e.schema,
      e.table,
      e.index,
      e.realSize,
      `${e.bloatSize} (${e.bloatPct}%)`,
      "id" in s ? s.id : "",
      reportResult(s),
    ];
  });
  const table =
    rows.length > 0
      ? formatTableText(
          [
            "INSTANCE",
            "DATABASE",
            "SCHEMA",
            "TABLE",
            "INDEX",
            "SIZE BEFORE",
            "BLOAT BEFORE",
            "REINDEX ID",
            "RESULT",
          ],
          rows,
        )
      : "No reindex candidates found.";
  const problems = state.problems.map((p) => `  ${p.where}: ${p.message}`).join("\n");
  return problems ? `${table}\n\nProblems:\n${problems}` : table;
}

// ---------------------------------------------------------------------------
// Imperative shell
// ---------------------------------------------------------------------------

class AmplmktError extends Schema.TaggedError<AmplmktError, { readonly brand: unique symbol }>()(
  "AmplmktError",
  {
    message: Schema.String,
  },
) {}

class FatalError extends Schema.TaggedError<FatalError, { readonly brand: unique symbol }>()(
  "FatalError",
  {
    message: Schema.String,
  },
) {}

const AuthStatus = Schema.Struct({ active: Schema.Boolean });
const Instances = Schema.Array(Schema.Struct({ kind: Schema.String, name: Schema.String }));
const StartedReindex = Schema.Struct({ id: Schema.String, status: Schema.String });
const ReindexStatus = Schema.Struct({ status: Schema.String });
const decodeErrorPayload = Schema.decodeUnknownOption(
  Schema.fromJsonString(Schema.Struct({ error: Schema.String })),
);

const decodeJsonOutput = <S extends Schema.Codec<unknown, unknown>>(schema: S) => {
  const decode = Schema.decodeUnknownEffect(Schema.fromJsonString(schema));
  return (output: string) =>
    decode(output).pipe(
      Effect.mapError(
        (error) => new AmplmktError({ message: `unexpected amplmkt output: ${error.message}` }),
      ),
    );
};

interface CommandResult {
  readonly code: number;
  readonly stderr: string;
  readonly stdout: string;
}

// amplmkt prints `{"error": ...}` for --format json failures; fall back to the tail of the raw output.
function errorMessage(result: CommandResult): string {
  for (const output of [result.stdout, result.stderr]) {
    const payload = decodeErrorPayload(output);
    if (payload._tag === "Some") {
      return payload.value.error;
    }
  }
  return (result.stderr.trim() || result.stdout.trim() || `exit code ${result.code}`)
    .split("\n")
    .slice(-3)
    .join(" ");
}

interface ReindexTarget {
  readonly database: string;
  readonly index: string;
  readonly instance: string;
  readonly schema: string;
}

class Amplmkt extends Context.Service<
  Amplmkt,
  {
    readonly isLoggedIn: Effect.Effect<boolean>;
    readonly listInstances: Effect.Effect<
      ReadonlyArray<{ readonly kind: string; readonly name: string }>,
      AmplmktError
    >;
    psql(
      instance: string,
      database: string | undefined,
      args: ReadonlyArray<string>,
    ): Effect.Effect<string, AmplmktError>;
    reindexStatus(id: string): Effect.Effect<string, AmplmktError>;
    startReindex(target: ReindexTarget): Effect.Effect<typeof StartedReindex.Type, AmplmktError>;
  }
>()("btree-reindex-amplmkt/Amplmkt") {
  static readonly layer = Layer.effect(
    Amplmkt,
    Effect.gen(function* () {
      const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
      // Override for testing against a fake amplmkt.
      const bin = yield* Config.String("AMPLMKT_BIN").pipe(Config.withDefault("amplmkt"));

      const run = Effect.fnUntraced(
        function* (args: ReadonlyArray<string>, env: Record<string, string> = {}) {
          const handle = yield* spawner.spawn(
            ChildProcess.make(bin, args, { env, extendEnv: true, stdin: "ignore" }),
          );
          const [stdout, stderr, code] = yield* Effect.all(
            [
              Stream.mkString(Stream.decodeText(handle.stdout)),
              Stream.mkString(Stream.decodeText(handle.stderr)),
              handle.exitCode,
            ],
            { concurrency: "unbounded" },
          );
          return { code: Number(code), stderr, stdout } satisfies CommandResult;
        },
        Effect.scoped,
        Effect.mapError(
          (cause) => new AmplmktError({ message: `could not run ${bin}: ${cause.message}` }),
        ),
      );

      const runOrFail = Effect.fnUntraced(function* (
        args: ReadonlyArray<string>,
        env?: Record<string, string>,
      ) {
        const result = yield* run(args, env);
        if (result.code !== 0) {
          return yield* new AmplmktError({ message: errorMessage(result) });
        }
        return result.stdout;
      });

      const runJson = <S extends Schema.Codec<unknown, unknown>>(schema: S) => {
        const decode = decodeJsonOutput(schema);
        return (args: ReadonlyArray<string>) =>
          runOrFail([...args, "--format", "json"]).pipe(Effect.flatMap(decode));
      };

      const isLoggedIn = runJson(AuthStatus)(["auth", "status"]).pipe(
        Effect.map((status) => status.active),
        Effect.orElseSucceed(() => false),
      );

      const listInstances = runJson(Instances)(["db", "list", "--env", "production"]);

      const psql = Effect.fn("Amplmkt.psql")(function* (
        instance: string,
        database: string | undefined,
        args: ReadonlyArray<string>,
      ) {
        const target = database
          ? ["--instance", instance, "--database", database]
          : ["--instance", instance];
        return yield* runOrFail(
          [
            "db",
            "connect",
            ...target,
            "--role",
            "readonly",
            "--",
            "-X",
            "-A",
            "-t",
            "-q",
            "-F",
            "\t",
            "-v",
            "ON_ERROR_STOP=1",
            // amplmkt overrides application_name from PGOPTIONS, so set it in the session.
            "-c",
            "set application_name = 'btree-reindex-amplmkt-goncalo'",
            ...args,
          ],
          // Forces psql, which the flags above require.
          { AMPLMKT_CLI_PSQL_BIN: "psql" },
        );
      });

      const startReindex = Effect.fn("Amplmkt.startReindex")(function* (target: ReindexTarget) {
        return yield* runJson(StartedReindex)([
          "db",
          "reindex",
          "--instance",
          target.instance,
          "--database",
          target.database,
          "--schema",
          target.schema,
          "--index",
          target.index,
        ]);
      });

      const reindexStatus = Effect.fn("Amplmkt.reindexStatus")(function* (id: string) {
        const { status } = yield* runJson(ReindexStatus)(["db", "reindex", "status", "--id", id]);
        return status;
      });

      return Amplmkt.of({ isLoggedIn, listInstances, psql, reindexStatus, startReindex });
    }),
  );
}

interface KeyPress {
  readonly ctrl: boolean;
  readonly name: string;
  readonly selectedKey: string | undefined;
  readonly shift: boolean;
}

class Tui extends Context.Service<
  Tui,
  {
    readonly keys: Stream.Stream<KeyPress>;
    render(state: AppState, now: number): Effect.Effect<void>;
  }
>()("btree-reindex-amplmkt/Tui") {
  static readonly layer = Layer.effect(
    Tui,
    Effect.gen(function* () {
      // Terminal default and ANSI palette colors, so the TUI follows the terminal's light or dark theme.
      const fg = RGBA.defaultForeground();
      const bg = RGBA.defaultBackground();
      const border = { border: true, borderColor: RGBA.fromIndex(8), titleColor: fg };
      const text = { bg, fg };
      const muted = { ...text, attributes: TextAttributes.DIM };
      // The terminal default foreground cannot serve as a background, so pick the highlight from the reported theme.
      const selectionColors = { dark: "#3a4a5c", light: "#cfe0f7" };

      const renderer = yield* Effect.acquireRelease(
        Effect.promise(() => createCliRenderer({ backgroundColor: bg, exitOnCtrlC: false })),
        (renderer) =>
          Effect.promise(() => {
            renderer.destroy();
            return renderer.closed;
          }),
      );

      const root = new BoxRenderable(renderer, {
        flexDirection: "column",
        height: "100%",
        width: "100%",
      });
      const header = new TextRenderable(renderer, {
        ...text,
        attributes: TextAttributes.BOLD,
        content: "",
        height: 1,
      });
      const columns = new TextRenderable(renderer, { ...muted, content: "", height: 1 });
      const emptyState = new TextRenderable(renderer, { ...muted, content: "", flexGrow: 1 });
      const list = new SelectRenderable(renderer, {
        backgroundColor: bg,
        flexGrow: 1,
        focusedBackgroundColor: bg,
        focusedTextColor: fg,
        options: [],
        selectedTextColor: fg,
        showDescription: false,
        showScrollIndicator: true,
        textColor: fg,
      });
      const details = new BoxRenderable(renderer, { ...border, height: 5, title: "Selected" });
      const detailsText = new TextRenderable(renderer, { ...text, content: "" });
      details.add(detailsText);
      const bottom = new BoxRenderable(renderer, { flexDirection: "row", height: 3 });
      const instancesBox = new BoxRenderable(renderer, {
        ...border,
        flexBasis: 0,
        flexGrow: 2,
        title: "Instances",
      });
      const instancesText = new TextRenderable(renderer, {
        ...text,
        content: "",
        wrapMode: "none",
      });
      instancesBox.add(instancesText);
      const problemsBox = new BoxRenderable(renderer, {
        ...border,
        flexBasis: 0,
        flexGrow: 1,
        title: "Problems",
      });
      const problemsText = new TextRenderable(renderer, {
        ...text,
        content: "",
        fg: RGBA.fromIndex(1),
        wrapMode: "none",
      });
      problemsBox.add(problemsText);
      bottom.add(instancesBox);
      bottom.add(problemsBox);
      const footer = new TextRenderable(renderer, { ...text, content: "", height: 1 });
      for (const child of [header, columns, emptyState, list, details, bottom, footer]) {
        root.add(child);
      }
      renderer.root.add(root);

      yield* Effect.promise(() => renderer.waitForThemeMode(300));

      const selectedKey = () => {
        const value: unknown = list.getSelectedOption()?.value;
        return Predicate.isString(value) ? value : undefined;
      };
      let entriesByKey = new Map<string, Entry>();
      const renderDetails = () => {
        const selected = entriesByKey.get(selectedKey() ?? "");
        detailsText.content = selected ? describeEntry(selected) : "";
        renderer.requestRender();
      };
      // SelectRenderable emits selectionChanged from setSelectedIndex too, so only the details pane reacts to it.
      list.on("selectionChanged", renderDetails);

      const render = (state: AppState, now: number) =>
        Effect.sync(() => {
          list.selectedBackgroundColor = selectionColors[renderer.themeMode ?? "dark"];
          header.content = headerLine(state, now);
          const footerContent = footerLine(state);
          footer.content = footerContent.text;
          footer.fg = footerContent.warning ? RGBA.fromIndex(1) : fg;
          footer.attributes = footerContent.warning ? TextAttributes.BOLD : TextAttributes.DIM;

          const previouslySelected = selectedKey();
          // The list draws a 3-column selection indicator and a 1-column scroll indicator.
          const table = entryTable(state, now, renderer.width - 4);
          columns.content = `   ${table.header}`;
          list.options = table.rows.map((row) => ({
            description: "",
            name: row.line,
            value: row.key,
          }));
          const selectedIndex = table.rows.findIndex((row) => row.key === previouslySelected);
          if (selectedIndex >= 0 && selectedIndex !== list.getSelectedIndex()) {
            list.setSelectedIndex(selectedIndex);
          }

          emptyState.visible = table.rows.length === 0;
          list.visible = table.rows.length > 0;
          // Hiding the list drops its focus, so take it back once rows appear.
          if (list.visible && !list.focused) {
            list.focus();
          }
          emptyState.content = emptyStateText(state, now);
          bottom.height = Math.min(14, Math.max(state.instances.length, 1) + 2);
          instancesText.content = instanceLines(state, now);
          problemsText.content = state.problems.map((p) => `${p.where}: ${p.message}`).join("\n");
          entriesByKey = new Map(state.entries.map((e) => [e.key, e]));
          renderDetails();
        });

      const keys = Stream.callback<KeyPress>((queue) => {
        const onKey = (key: KeyEvent) =>
          Queue.offerUnsafe(queue, {
            ctrl: key.ctrl,
            name: key.name,
            selectedKey: selectedKey(),
            shift: key.shift,
          });
        return Effect.acquireRelease(
          Effect.sync(() => renderer.keyInput.on("keypress", onKey)),
          () => Effect.sync(() => renderer.keyInput.off("keypress", onKey)),
        );
      });

      return Tui.of({ keys, render });
    }),
  );
}

// Runs the TUI until the user quits and returns the final state for the report.
const runTui = Effect.fn("runTui")(function* (options: {
  readonly dryRun: boolean;
  readonly pollInterval: Duration.Duration;
}) {
  const amplmkt = yield* Amplmkt;
  const tui = yield* Tui;
  const state = yield* Ref.make(initialState(options.dryRun));
  const stopped = yield* Deferred.make<void, FatalError>();
  const reindexes = yield* FiberSet.make<void>();

  const update = (f: (state: AppState, now: number) => AppState) =>
    Effect.flatMap(Clock.currentTimeMillis, (now) => Ref.update(state, (s) => f(s, now)));

  const schedule: Effect.Effect<void> = Effect.suspend(() =>
    Effect.gen(function* () {
      const claimed = yield* Ref.modify(state, (s) =>
        claimReindexes(s, MAX_REINDEXES_PER_INSTANCE),
      );
      for (const entry of claimed) {
        yield* FiberSet.run(reindexes, runReindex(entry));
      }
    }),
  );

  // Polls instead of `amplmkt db reindex watch` so transient status errors (such as an expired session) only pause
  // tracking. The instance slot stays taken until the outcome is known.
  const pollUntilFinished = Effect.fnUntraced(function* (
    key: string,
    id: string,
    startedAt: number,
  ) {
    const pollOnce = amplmkt.reindexStatus(id).pipe(
      Effect.matchEffect({
        onFailure: (error) =>
          update((s) =>
            noteAmplmktResult(
              updateEntry(s, key, (e) => ({
                ...e,
                state: { ...e.state, pollError: error.message },
              })),
              error.message,
            ),
          ),
        onSuccess: (status) =>
          update((s, now) =>
            noteAmplmktResult(
              updateEntry(s, key, (e) => applyServerStatus(e, id, status, startedAt, now)),
            ),
          ),
      }),
      Effect.andThen(Ref.get(state)),
      Effect.map((s) => s.entries.find((e) => e.key === key)?.state.kind !== "running"),
    );
    yield* pollOnce.pipe(
      Effect.delay(options.pollInterval),
      Effect.repeat({ until: (finished) => finished }),
    );
  });

  const runReindex = Effect.fnUntraced(function* (entry: Entry) {
    const startedAt = yield* Clock.currentTimeMillis;
    yield* amplmkt.startReindex(entry).pipe(
      Effect.matchEffect({
        onFailure: (error) =>
          update((s) =>
            noteAmplmktResult(
              updateEntry(s, entry.key, (e) => ({
                ...e,
                state: { error: error.message, kind: "start_failed" },
              })),
              error.message,
            ),
          ),
        onSuccess: (started) =>
          update((s, now) =>
            noteAmplmktResult(
              updateEntry(s, entry.key, (e) =>
                applyServerStatus(e, started.id, started.status, startedAt, now),
              ),
            ),
          ).pipe(Effect.andThen(pollUntilFinished(entry.key, started.id, startedAt))),
      }),
    );
    yield* schedule;
  });

  const discoverDatabase = Effect.fn("discoverDatabase")(function* (
    instance: string,
    database: string,
  ) {
    const candidates = parseCandidates(
      yield* amplmkt.psql(instance, database, ["-f", CANDIDATES_SQL]),
    );
    if (candidates.length === 0) {
      return;
    }
    // The candidate query does not return schemas, so resolve them separately.
    const schemas = parseSchemaLookup(
      yield* amplmkt.psql(instance, database, ["-c", schemaLookupSql(candidates)]),
    );
    yield* update((s) => addCandidates(s, instance, database, candidates, schemas));
    yield* schedule;
  });

  const discoverInstance = Effect.fn("discoverInstance")(function* (instance: string) {
    yield* update((s, now) => setPhase(s, instance, "checking", "active", now));
    const check = yield* amplmkt
      .psql(instance, undefined, ["-c", "select pg_is_in_recovery()", "-c", LIST_DATABASES_SQL])
      .pipe(
        Effect.map(parseInstanceCheck),
        Effect.catch((error) =>
          update((s, now) =>
            setPhase(
              addProblem(s, instance, error.message),
              instance,
              "could not connect",
              "error",
              now,
            ),
          ).pipe(Effect.as(undefined)),
        ),
      );
    if (check === undefined) {
      return;
    }
    if (check.kind === "replica") {
      return yield* update((s, now) => setPhase(s, instance, "skipped (replica)", "skipped", now));
    }

    const { databases } = check;
    yield* update((s) => countDatabaseScans(s, { total: databases.length }));
    for (const [i, database] of databases.entries()) {
      yield* update((s, now) =>
        setPhase(s, instance, `scanning ${database} (${i + 1}/${databases.length})`, "active", now),
      );
      yield* discoverDatabase(instance, database).pipe(
        Effect.catch((error) =>
          update((s) => addProblem(s, `${instance}/${database}`, error.message)),
        ),
      );
      yield* update((s) => countDatabaseScans(s, { done: 1 }));
    }
    yield* update((s, now) =>
      setPhase(
        s,
        instance,
        `scanned ${databases.length} db${databases.length === 1 ? "" : "s"}`,
        "done",
        now,
      ),
    );
  });

  const startup = Effect.gen(function* () {
    if (!(yield* amplmkt.isLoggedIn)) {
      return yield* new FatalError({
        message: "No active amplmkt session. Run `amplmkt auth login` and try again.",
      });
    }
    yield* update((s) => ({ ...s, startupStep: "Listing production instances…" }));
    const instances = selectPrimaryInstances(
      yield* amplmkt.listInstances.pipe(
        Effect.mapError(
          (error) =>
            new FatalError({ message: `Could not list production instances: ${error.message}` }),
        ),
      ),
    );
    yield* update((s, now) => startScanning(s, instances, now));
    yield* Effect.forEach(instances, discoverInstance, { concurrency: "unbounded", discard: true });
  });

  const handleKey = Effect.fnUntraced(function* (key: KeyPress) {
    const { selectedKey } = key;
    if (key.name === "q" || (key.ctrl && key.name === "c")) {
      const decision = yield* Ref.modify(state, requestQuit);
      if (decision === "quit") {
        yield* Deferred.succeed(stopped, undefined);
      }
      return;
    }
    if (key.name === "R" || (key.name === "r" && key.shift)) {
      yield* update((s) => retryFailedStarts(s, new Set(s.entries.map((e) => e.key))));
    } else if (key.name === "r" && selectedKey !== undefined) {
      yield* update((s) => retryFailedStarts(s, new Set([selectedKey])));
    } else if (key.name === "s" && selectedKey !== undefined) {
      yield* update((s) => startNext(s, selectedKey));
    } else {
      yield* update(cancelQuit);
    }
    yield* schedule;
  });

  const renderOnce = Effect.flatMap(
    Effect.all([Ref.get(state), Clock.currentTimeMillis]),
    ([s, now]) => tui.render(s, now),
  );
  yield* Effect.forkScoped(Effect.repeat(renderOnce, Schedule.spaced("100 millis")));
  yield* Effect.forkScoped(Stream.runForEach(tui.keys, handleKey));
  yield* Effect.forkScoped(startup.pipe(Effect.catch((error) => Deferred.fail(stopped, error))));

  yield* Deferred.await(stopped);
  return yield* Ref.get(state);
});

const main = Effect.fn("main")(
  function* (options: { readonly dryRun: boolean; readonly pollInterval: number }) {
    const fs = yield* FileSystem.FileSystem;
    const hasQuery = yield* fs.exists(CANDIDATES_SQL).pipe(Effect.orElseSucceed(() => false));
    if (!hasQuery) {
      return yield* new FatalError({ message: `${CANDIDATES_SQL} not found` });
    }

    // The Tui layer is released, restoring the terminal, before the report is printed.
    const finalState = yield* runTui({
      dryRun: options.dryRun,
      pollInterval: Duration.seconds(options.pollInterval),
    }).pipe(Effect.scoped, Effect.provide(Tui.layer));
    yield* Console.log(formatReport(finalState));
  },
  Effect.tapError((error) => Console.error(error.message)),
);

const command = Command.make(
  "btree-reindex-amplmkt",
  {
    dryRun: Flag.Boolean("dry-run").pipe(
      Flag.withDescription("Find candidates without reindexing"),
      Flag.withDefault(false),
    ),
    pollInterval: Flag.Int("poll-interval").pipe(
      Flag.withDescription("Seconds between reindex status checks"),
      Flag.withSchema(Schema.Int.pipe(Schema.check(Schema.isGreaterThan(0)))),
      Flag.withDefault(30),
    ),
  },
  main,
).pipe(
  Command.withDescription(
    "Find bloated btree indexes on production PostgreSQL primaries and reindex them. " +
      "Keys: ↑/↓ move, s start selected next (within the concurrency limit), r retry selected failed start, " +
      "R retry all failed starts, q quit.",
  ),
);

command.pipe(
  Command.run({ version: "1.0.0" }),
  Effect.provide(Amplmkt.layer.pipe(Layer.provideMerge(BunServices.layer))),
  (program) => BunRuntime.runMain(program, { disableErrorReporting: true }),
);
