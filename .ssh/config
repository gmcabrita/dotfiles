Include ~/.orbstack/ssh/config
SetEnv TERM=xterm-256color

# Load the key into Apple's ssh-agent for 16 hours after the passphrase is entered.
# The agent keeps the key in memory while the screen is locked, so remote shells (Rex) can use it.
# The passphrase is not stored in the Keychain, so after 16 hours ssh asks for it again.
Host *
	AddKeysToAgent 16h
	IdentityFile ~/.ssh/id_ed25519
